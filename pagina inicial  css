:root {
  --texto: #1b1340;
  --azul: #4dffe4;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background-color: whitesmoke;
  color: var(--texto);
  position: relative;
}

.menu {
  background-color: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  width: 900px;
  max-width: 94%;
  height: 70px;
  border: 1.5px solid rgba(55, 147, 213, 0.8);
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  z-index: 10;
  position: absolute;
  top: 3%;
  left: 50%;
  transform: translateX(-50%);
  animation: expandirMenu 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.domestico, .distan, .indus {
  background-color: transparent;
  color: black;
  font-weight: 600;
  font-size: 16px;
  padding: 18px 28px;
  border-radius: 999px;
  border: transparent;
  position: absolute;
  top: 14%;
  cursor: pointer;
}

.distan    { left: 24%; }
.domestico { left: 48%; }
.indus     { left: 73%; }

.distan:hover, .domestico:hover, .indus:hover {
  color: #3793d5cc;
  text-decoration: underline;
}

.logo {
  position: absolute;
  left: 30px;
  top: 0;
  margin: 0;
  line-height: 70px;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  font-size: 35px;
  color: black;
  cursor: pointer;
}

@keyframes expandirMenu {
  from { opacity: 0; transform: translateX(-50%) scale(0.9); }
  to   { opacity: 1; transform: translateX(-50%) scale(1); }
}

.hero {
  position: relative;
  height: 100vh;
  min-height: 600px;
}

.title {
  position: absolute;
  top: 150px;
  left: 0;
  right: 0;
  margin: 0;
  padding: 0 5%;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  font-size: clamp(32px, 5vw, 60px);
  text-align: center;
}

.exemplo {
  position: absolute;
  top: 57%;
  left: 50%;
  transform: translateX(-50%);
  width: min(90%, 700px);
  margin: 0;
  font-size: clamp(16px, 2vw, 25px);
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  text-align: center;
}

.conhe {
  position: absolute;
  left: 50%;
  top: 76%;
  transform: translateX(-50%);
  width: clamp(220px, 28vw, 330px);
  height: 60px;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  font-size: clamp(18px, 2vw, 30px);
  background-color: var(--azul);
  color: var(--texto);
  border-radius: 999px;
  border-color: transparent;
  cursor: pointer;
}

.conhe:hover {
  background-color: rgba(117, 183, 195, 0.556);
  color: #1b1340;
}

.faixa {
  width: 100%;
  overflow: hidden;
  background: var(--texto);
  color: var(--azul);
  padding: 14px 0;
  position: absolute;
  top: 105%;
}

.faixa-texto {
  display: flex;
  width: max-content;
  animation: passar 20s linear infinite;
}

.faixa-texto span {
  white-space: nowrap;
  padding-right: 40px;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  font-size: 20px;
  font-weight: 600;
}

@keyframes passar {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}


.setores {
  background-color: #132340;
  width: 80%;
  margin: 80px auto 0;
  padding: 24px;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  border-radius: 10px;
  border: 1.5px solid rgba(55, 147, 213, 0.8);
}

.indus4 {
  background-color: white;
  width: 100%;
  border-radius: 10px;
  padding: 10px;
}

.card-topico {
  display: flex;
  width: 100%;
  height: 120px;
  color: white;
  border-radius: 15px;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  background-image: linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0.2)), url('https://ststecnologia.com.br/wp-content/uploads/2024/10/image-1.png');
  background-size: cover;
  background-position: center;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  cursor: pointer;
}

.card-txt {
  color: black;
  text-align: left;
  font-size: 14px;
  padding: 10px 6px 0;
  cursor: text;
}


footer {
  background-color: black;
  position: relative;
  min-height: 500px;
  max-width: 1500px;
  width: 90%;
  margin: 80px auto 0;
  color: white;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  clip-path: polygon(0 0, 100% 0, 100% 87%, 0 100%);
  padding-bottom: 60px;
}

footer h1 {
  position: absolute;
  top: 0;
  font-size: 35px;
  left: 2%;
  color: white;
}

footer h2 {
  color: white;
}

footer a {
  text-decoration: none;
}

.arrow {
  color: #3793d5cc;
}

.rod-ind {
  position: absolute;
  left: 9%;
  top: 10%;
}

.list-ind {
  position: absolute;
  left: 8%;
  top: 20%;
  font-size: 20px;
  color: white;
  list-style: none;
  padding: 0;
}

.list-ind li {
  margin-bottom: 20px;
}

#espaco {
  height: 10px;
  background-color: whitesmoke;
}

/* ---------- RESPONSIVO ---------- */
@media (max-width: 900px) {
  .domestico, .indus, .distan {
    padding: 12px 10px;
    font-size: 14px;
  }

  .title {
    top: 180px;
  }
}

@media (max-width: 600px) {
  .menu {
    border-radius: 24px;
    height: 110px;
  }

  .logo {
    left: 0;
    right: 0;
    text-align: center;
    line-height: 50px;
  }

  .distan, .domestico, .indus {
    top: 55px;
    padding: 8px 6px;
    font-size: 12px;
  }

  .distan    { left: 2%; }
  .domestico { left: 36%; }
  .indus     { left: 70%; }

  .title {
    top: 220px;
  }

  .exemplo {
    top: 50%;
  }

  .conhe {
    height: 52px;
  }

  .setores {
    width: 94%;
    padding: 12px;
  }
}
