:root {
  --texto: #1b1340;
  --azul: #4dffe4;

}

body {
   background-color: whitesmoke;
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-size: cover;
    color: var(--texto);
}

.menu {
  background-color: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  width: 900px;
  height: 70px;
  max-width: 1200px;
  margin: 0 auto;
  border: 1.5px solid rgba(55, 147, 213, 0.8);
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  padding: 15px 30px;
  z-index: 10;
  position: absolute;
  top: 3%;
  left: 15%;
  align-items: center;
  justify-content: flex-start;
  padding: 0 40px; 
  animation: expandirMenu 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  text-decoration: none;
}


.logo {
  font-family: "Bricolage Grotesque", Arial, sans-serif;
    text-align: center;
    font-size: 230%;
    margin-top: 1.8%;
    margin-left: -90%;
}

a{
  text-decoration: none;
  color: inherit;
}

.title {
  position: absolute;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
    text-align: center;
    font-size: 60px;
     margin-top:200px;
     right: 29%;
     top: 0;
}

.domestico, .distan, .indus {
  background-color: transparent;
  color: black;
  font-weight: 600px;
  font-size: 16px;
  padding: 18px 28px;
  border-radius: 999px;
  border: transparent;
  position: absolute;
  left: 50%;
  top: 14%;
  cursor: pointer;
}

.distan {
  position: absolute;
  left: 30%;
}

.domestico{
  position: absolute;
  left: 55%;
}

.indus{
  position: absolute;
  left: 80%;
}

.distan:hover, .domestico:hover, .indus:hover {
  color: #3793d5cc;
  text-decoration: underline;
}

.exemplo {
  position: absolute;
  font-size: 25px;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  text-align: center;
  left: 25%;
  top: 55%;
}

.conhe {
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  background-color: var(--azul);
  color: var(--texto);
  border-radius: 999px;
  border-color: transparent;
  font-size: 30px;
  width: 330px;
  height: 60px;
  position: absolute;
  left: 39%; 
  bottom: 18%;
  background-color: #4dffe4;
}

.conhe:hover {
  background-color: rgba(117, 183, 195, 0.556);
  color: #1b1340;
}
