:root {
  --texto: #1b1340;
  --amarelo: #ffd84d;

}

body {
    background-color: #f2efff;
    color: var(--texto);
}


.menu {
  background: white;
  border:1.5px solid rgba(188,210,255,.8);
  border-radius: 999px;
  width: 1100px;
  height: 90px;
  position: absolute;
  top: 6%;
  left: 10%;
  border-color: transparent;
}

.logo {
  font-family: "Bricolage Grotesque", Arial, sans-serif;
    text-align: center;
    font-size: 230%;
    margin-top: 1.8%;
    margin-left: -90%;
}



.title {
  font-family: "Bricolage Grotesque", Arial, sans-serif;
    text-align: center;
    font-size: 60px;
     margin-top:200px;
}

.domestico, .indus, .distan {
  background-color: var(--texto);
  color: var(--amarelo);
  font-weight: 600px;
  font-size: 16px;
  padding: 18px 28px;
  border-radius: 999px;
  border: transparent;
  position: absolute;
  left: 720px;
  top: 17px;
  cursor: pointer;
}

.indus {
  position: absolute;
  left: 450px;
}

.distan {
  position: absolute;
  left: 180px;
}

.distan:hover {
  opacity: 0.85;
}

.indus:hover {
  opacity: 0.85;
}

.domestico:hover {
  opacity: 0.85;
}

.exemplo {
  font-size: 25px;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  text-align: center;
}

.conhe {
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  background-color: var(--amarelo);
  color: var(--texto);
  border-radius: 999px;
  border-color: transparent;
  font-size: 30px;
  width: 330px;
  height: 60px;
  position: absolute;
  left: 500px; 
}

.conhe:hover {
  opacity: 0.85;
}
