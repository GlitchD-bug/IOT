:root {
  --texto: #1b1340;
  --azul: #4dffe4;

}

body {
   background: 
   linear-gradient(
    180deg,
    #FAFAFC 0%,
    #9bf5f5a1 100%
    );
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-size: cover;
    color: var(--texto);
}

.menu {
  background: rgba(255,255,255,.14);       
  -webkit-backdrop-filter: blur(14px);    
  backdrop-filter: blur(14px);
  border: 1.5px solid rgba(55, 147, 213, 0.8);
  border-radius: 30px;
  width: 1300px;
  height: 90px;
  position: absolute;
  top: 6%;
  left: 2%;
  align-items: center;
  justify-content: flex-start;
  padding: 0 40px; 
  animation: expandirMenu 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.logo {
  font-family: "Bricolage Grotesque", Arial, sans-serif;
    text-align: center;
    font-size: 230%;
    margin-top: 1.8%;
    margin-left: -90%;
}



.title {
  position: absolute;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
    text-align: center;
    font-size: 60px;
     margin-top:200px;
     right: 29%;
     top: 0;
}

.domestico, .indus, .distan {
  background-color: var(--texto);
  color: var(--azul);
  font-weight: 600px;
  font-size: 16px;
  padding: 18px 28px;
  border-radius: 999px;
  border: transparent;
  position: absolute;
  left: 720px;
  top: 17px;
  cursor: pointer;
}

.indus {
  position: absolute;
  left: 450px;
}

.distan {
  position: absolute;
  left: 180px;
}

.distan:hover, .indus:hover, .domestico:hover {
  background-color: rgba(117, 183, 195, 0.556);
  color: #1b1340;
  border-color: #082a24;
  
}

.exemplo {
  position: absolute;
  font-size: 25px;
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  text-align: center;
  left: 25%;
  top: 55%;
}

.conhe {
  font-family: "Bricolage Grotesque", Arial, sans-serif;
  background-color: var(--azul);
  color: var(--texto);
  border-radius: 999px;
  border-color: transparent;
  font-size: 30px;
  width: 330px;
  height: 60px;
  position: absolute;
  left: 39%; 
  bottom: 18%;
  background-color: #4dffe4;
}

.conhe:hover {
  background-color: rgba(117, 183, 195, 0.556);
  color: #1b1340;
}

